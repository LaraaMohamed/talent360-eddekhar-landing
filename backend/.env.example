# Preferred: Google Apps Script bridge running as business-growth@talent-360.me (see apps-script/README.md)
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
# Calendars that must all be free for a slot, and guests invited to every booking
BUSY_CALENDARS=darkawi@talent-360.me
BOOKING_GUESTS=business-growth@talent-360.me
CONSULTANT_CALENDAR_ID=darkawi@talent-360.me
PORT=8080
PUBLIC_BASE_URL=https://talent-360.me/eddekhar
# Google Workspace service account (domain-wide delegation, calendar scope), JSON on one line
GOOGLE_SERVICE_ACCOUNT_JSON=
CONSULTANT_EMAIL=business-growth@talent-360.me
CONSULTANT_CALENDAR_ID=primary
# Optional consultant name shown in confirmation emails
CONSULTANT_NAME_AR=
CONSULTANT_NAME_EN=
# Bilingual confirmation emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=business-growth@talent-360.me
SMTP_PASS=
MAIL_FROM=Talent360 <business-growth@talent-360.me>
# Team inbox notified of every lead-magnet request
TEAM_EMAIL=business-growth@talent-360.me
# Talent360 CRM (Railway) lead intake endpoint
CRM_WEBHOOK_URL=
CRM_API_KEY=
# Random 32+ char secret for cancel/reschedule links
LINK_SECRET=
